{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:css",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "public/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/purge-sessions", "schedule": "0 3 * * *" }
  ]
}
