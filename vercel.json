{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:css",
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "public/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/purge-maintenance", "schedule": "0 3 * * *" }
  ]
}
