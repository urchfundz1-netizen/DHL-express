# ---- SwiftNova Global Express :: Environment Configuration ----
# Copy this file to ".env" and adjust values before running locally.

# Server
PORT=3000
NODE_ENV=development

# Session security. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when serving over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false

# Default administrator created on the first start (and by the seed script).
# Set a strong password before the first start — no default is applied.
ADMIN_EMAIL=admin@yourdomain.test
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# ---- Firebase Firestore ----
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. The private key must be wrapped in double quotes and its line
# breaks written as \n.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: a second (named) Firestore database. Leave empty for (default).
FIRESTORE_DATABASE_ID=

# Optional: Firebase Storage bucket. Only available on the Blaze plan.
FIREBASE_STORAGE_BUCKET=

# ---- Shared rate limiting ----
# The login limiter keeps its counters in Firestore, so every serverless
# instance shares the same budget. The namespace keeps the development,
# preview and production budgets apart. Leave empty to derive it from
# VERCEL_ENV / NODE_ENV.
RATE_LIMIT_NAMESPACE=

# ---- Maintenance ----
# Bearer token for the /api/cron/* endpoints. Leave empty to allow loopback
# requests only. Vercel sends it automatically when the variable is set.
CRON_SECRET=

# Optional email notifications (leave SMTP_HOST empty to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SwiftNova Express <no-reply@swiftnova.test>"
